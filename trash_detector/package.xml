<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>trash_detector</name>
  <version>0.0.1</version>
  <description>Detects trash in camera images. Thin ROS wrapper around the EdgeTrash `edgetrash` library; backend chosen by ROS parameter (hsv, onnx, tflite, hailo, oak).</description>
  <maintainer email="trashrobotedge@users.noreply.github.com">TrashRobotEdge</maintainer>
  <license>TODO</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
